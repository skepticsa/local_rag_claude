# ============================================
# LLM Provider Selection
# ============================================
# Choose: "claude" (API, costs money) or "ollama" (local, free)
LLM_PROVIDER=claude

# ============================================
# Claude API Configuration (if LLM_PROVIDER=claude)
# ============================================
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here
CLAUDE_MODEL=claude-sonnet-4-5-20250929
# Available models: claude-sonnet-4-5-20250929, claude-opus-4-1-20250805, claude-3-5-haiku-20241022

# ============================================
# Ollama Configuration (if LLM_PROVIDER=ollama)
# ============================================
# Recommended models based on your RAM:
# For 32GB RAM (RECOMMENDED):
# - llama3.1:8b (fast, ~8GB RAM, good quality)
# - mistral:7b (alternative, ~7GB RAM)
#
# For 64GB+ RAM only:
# - llama3.1:70b-instruct-q4_K_M (best quality, ~42GB RAM)
# - llama3.2:90b (very high quality, ~50GB RAM)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# General Settings
# ============================================
MAX_TOKENS=2000
TEMPERATURE=0.7
TOKENIZERS_PARALLELISM=true
